using System;
using System.Collections;   // IEnumerator 사용 시 필요
using UnityEngine;

public class CoroutineTest : MonoBehaviour
{
    private void Start()
    {
        StartCoroutine(TestCoroutine());    // TestCoroutine 시작
        // StopCoroutine("TestCoroutine");     yield break 대신 명시적으로 코루틴을 정지하는 코드
        Debug.Log("start");
    }

    private void FixedUpdate()
    {
        Debug.Log("FixedUpdate");
    }

    private void Update()
    {
        Debug.Log("Update");
    }
    
    private void LateUpdate()
    {
        Debug.Log("LateUpdate");
    }

    private IEnumerator TestCoroutine()
    {
        PrintColorLog("Start Coroutine");

        yield return null;
        PrintColorLog("yield return null");

        yield return new WaitForSeconds(1.0f);
        PrintColorLog("Wait for Seconds 1sec");

        yield return new WaitForFixedUpdate();
        PrintColorLog("Wait for FixedUpdate");

        yield return new WaitForEndOfFrame();
        PrintColorLog("Wait For End Of Frame");
        
        PrintColorLog("End Coroutine");
        yield break;


    }

    private void PrintColorLog(string text)     // 로그 색깔 출력
    {
        Debug.Log($"<color=yellow>{text}</color>>");
    }
}
```

