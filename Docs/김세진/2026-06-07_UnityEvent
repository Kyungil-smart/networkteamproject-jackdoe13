using UnityEngine;
using UnityEngine.Events; // 유니티 이벤트 사용

public class PlayerController : MonoBehaviour
{
    [field: SerializeField] public UnityEvent OnPetCalled { get; private set; } = new(); // Class 필드로 유니티 이벤트 선언

    private void Update()
    {
        if (Input.GetKeyDown(KeyCode.C))
        {
            CallPet();
        }
    }

    private void CallPet()
    {
        OnPetCalled.Invoke(); // 유니티 이벤트를 Invoke()로 실행
    }

}
```
